# 가상환경
.venv/
venv/

# 파이썬 캐시
__pycache__/
*.py[cod]
*.egg-info/

# 주피터
.ipynb_checkpoints/

# 데이터 (용량 큰 데이터셋은 git에 올리지 않음)
data/
*.csv
*.npy
*.pt
*.pth
*.ckpt

# OS / 에디터
.DS_Store
.idea/
.vscode/

# 비밀정보 — 2026-08-05 추가.
# 이전에는 미러 스크립트의 `--exclude '.env'` 가 이걸 막았는데, 이 폴더가 미러의
# **작업본**이 되면서 rsync 단계 자체가 사라졌다. 이제 .gitignore 가 유일한 방어선이다.
.env
.env.*
